<?xml version="1.0"?>
<!-- Checkstyle: revisa el código fuente. Aquí solo hay UNA regla: no imports sin usar. -->
<!DOCTYPE module PUBLIC
        "-//Checkstyle//DTD Checkstyle Configuration 1.3//EN"
        "https://checkstyle.org/dtds/configuration_1_3.dtd">
<module name="Checker">
    <property name="charset" value="UTF-8"/>      <!-- lee bien tildes y eñes -->
    <property name="severity" value="error"/>     <!-- cualquier incumplimiento rompe el build -->
    <module name="TreeWalker">
        <module name="UnusedImports"/>            <!-- falla si un import no se usa -->
    </module>
</module>
