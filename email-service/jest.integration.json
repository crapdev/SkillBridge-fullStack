{
  "moduleFileExtensions": [
    "js",
    "json",
    "ts"
  ],
  "rootDir": "src",
  "testRegex": ".*\\.int-spec\\.ts$",
  "transform": {
    "^.+\\.(t|j)s$": [
      "ts-jest",
      {
        "tsconfig": "<rootDir>/../tsconfig.spec.json"
      }
    ]
  },
  "testEnvironment": "node",
  "testTimeout": 30000,
  "transformIgnorePatterns": [
    "/node_modules/(?!promise-breaker/)"
  ]
}
