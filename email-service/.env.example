NODE_ENV=development
PORT=3000
APP_NAME=skillbridge-email-service

RABBITMQ_URL=amqp://skillbridge:skillbridge_dev@localhost:5672
RABBITMQ_EXCHANGE=booking.events
RABBITMQ_EMAIL_QUEUE=booking.emails.queue
RABBITMQ_EMAIL_DLQ=booking.emails.dlq
RABBITMQ_EMAIL_DLX=booking.emails.dlx

MAIL_PROVIDER=fake
MAIL_FROM=no-reply@skillbridge.local
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
BREVO_API_KEY=

FRONTEND_URL=http://localhost:4200

# Use the same PostgreSQL database where the Java backend ran Flyway V21.
# Do not point this service at a separate empty database.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
