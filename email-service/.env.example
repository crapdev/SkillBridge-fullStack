NODE_ENV=development
PORT=3000
APP_NAME=skillbridge-email-service

# Broker principal de SkillBridge (docker compose up -d rabbitmq desde la raíz).
# Desde la red Docker "skillbridge": amqp://guest:guest@rabbitmq:5672. Vacío = no se consumen eventos.
RABBITMQ_URL=amqp://guest:guest@localhost:5672
RABBITMQ_EXCHANGE=booking.events
RABBITMQ_EMAIL_QUEUE=booking.emails.queue
RABBITMQ_EMAIL_DLQ=booking.emails.dlq
RABBITMQ_EMAIL_DLX=booking.emails.dlx
RABBITMQ_EMAIL_RETRY_QUEUE=booking.emails.retry.queue
RABBITMQ_PREFETCH=5

# Reintentos de los correos de reservas: espera fija por intento y máximo de intentos antes de la DLQ
BOOKING_EMAIL_MAX_ATTEMPTS=5
BOOKING_EMAIL_RETRY_DELAY_MS=30000
# Segundos que un envío queda reservado (PROCESSING) antes de que otro intento pueda retomarlo
BOOKING_EMAIL_LEASE_SECONDS=120

# Contexto de reservas: endpoint interno del backend Java (PENDIENTE de implementar en Java).
# Sin BOOKING_CONTEXT_URL el consumidor no arranca y los eventos esperan en booking.emails.queue.
BOOKING_CONTEXT_URL=
INTERNAL_API_TOKEN=
BOOKING_CONTEXT_TIMEOUT_MS=5000

MAIL_PROVIDER=fake
MAIL_FROM=no-reply@skillbridge.local
MAILPIT_HOST=localhost
MAILPIT_PORT=1025
BREVO_API_KEY=

FRONTEND_URL=http://localhost:4200

# Base compartida de SkillBridge (la tabla email.booking_email_deliveries la crea Flyway V22 al arrancar Java).
# El docker-compose principal publica PostgreSQL en el puerto 5433 del host.
DATABASE_URL=postgres://skillbridge:skillbridge_dev@localhost:5433/skillbridge
DATABASE_SSL=false
